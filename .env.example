# Copy to .env and fill in. Nothing here is required for the local Docker
# Compose loop - compose sets what the backend needs. These matter once you
# run pieces by hand or deploy the frontend and backend to separate hosts.

# --- Backend -----------------------------------------------------------------
REDIS_HOST=localhost
REDIS_PORT=6379
USE_REDIS=true
# Comma-separated. Add your deployed frontend origin here.
CORS_ORIGINS=http://localhost:5173

# Auth defaults to on, so a misconfigured deploy fails closed. Setting this to
# false attributes every request to one shared id - local development only.
AUTH_ENABLED=true
SUPABASE_URL=https://<project>.supabase.co
# Only for legacy projects still signing with HS256. Newer projects sign with
# ES256/RS256 and publish a JWKS, which needs no secret here. Leave unset.
SUPABASE_JWT_SECRET=

# --- Frontend (frontend/.env.local, must be VITE_-prefixed to reach the app) --
# VITE_SUPABASE_URL=https://<project>.supabase.co
# VITE_SUPABASE_ANON_KEY=<anon key>
# Only when the API is on a different host than the frontend (e.g. Render +
# Netlify). Left unset, calls go to /api on the same origin.
# VITE_API_URL=https://<your-api>.onrender.com
